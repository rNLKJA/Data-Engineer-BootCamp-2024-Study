# Copy to .env (or export these) to override the defaults. All paths are optional;
# without them everything lives under original/project/data/.
SA_CRASH_DATA_DIR=./data
SA_CRASH_LAKE=./data/lake
SA_CRASH_WAREHOUSE=./data/warehouse/sa_crash.duckdb
DBT_PROFILES_DIR=./dbt
# Where the dashboard JSON is written (defaults to ../../web/app/project/dashboard-data.json)
# SA_CRASH_DASHBOARD_JSON=../../web/app/project/dashboard-data.json
# Turn off colour codes when capturing logs
DBT_USE_COLORS=false
PREFECT_LOGGING_COLORS=false
